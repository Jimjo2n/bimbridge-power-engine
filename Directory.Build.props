<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>BIMBRIDGE</Company>
    <Product>BIMBRIDGE</Product>
    <Version>0.9.6</Version>
    <InformationalVersion>0.9.6</InformationalVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Issue #7: a task without await or supervision loses its exceptions; treated as a compile error. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS4014</WarningsAsErrors>
    <!-- no build-machine paths inside the DLLs (pdb) -->
    <PathMap>$(MSBuildThisFileDirectory)=/bimbridge/</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
