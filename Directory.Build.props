<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>BIMBRIDGE</Company>
    <Product>BIMBRIDGE (PDI Revit MCP)</Product>
    <Version>0.9.1</Version>
    <InformationalVersion>0.9.1</InformationalVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Issue #7: una tarea sin await ni supervisión pierde sus excepciones; se trata como error de compilación. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS4014</WarningsAsErrors>
    <!-- sin rutas de la máquina de compilación dentro de las DLL (pdb) -->
    <PathMap>$(MSBuildThisFileDirectory)=/pdi-revit-mcp/</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
