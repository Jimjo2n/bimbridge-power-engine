<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests without Revit: engine, protocol and the full bridge against a simulated add-in. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bimbridge.Protocol\Bimbridge.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Bimbridge.Engine\Bimbridge.Engine.csproj" />
    <ProjectReference Include="..\..\src\Bimbridge.Setup.Core\Bimbridge.Setup.Core.csproj" />
    <ProjectReference Include="..\..\src\Bimbridge.Bridge\Bimbridge.Bridge.csproj" />
    <ProjectReference Include="..\..\src\Bimbridge.Scripting\Bimbridge.Scripting.csproj" />
    <ProjectReference Include="..\..\src\Bimbridge.AgentHost\Bimbridge.AgentHost.csproj" />
    <ProjectReference Include="..\Bimbridge.LeaseProbe\Bimbridge.LeaseProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- 0.9.0 Power Engine: native Rust library (if built with cargo) next to the tests, to compare C# = FFI = IPC. -->
  <ItemGroup>
    <None Include="..\..\native\power_engine\target\release\libbimbridge_power_engine.so" Condition="Exists('..\..\native\power_engine\target\release\libbimbridge_power_engine.so')" Link="libbimbridge_power_engine.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\power_engine\target\release\bimbridge_power_engine.dll" Condition="Exists('..\..\native\power_engine\target\release\bimbridge_power_engine.dll')" Link="bimbridge_power_engine.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
