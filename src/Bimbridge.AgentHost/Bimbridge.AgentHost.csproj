<Project Sdk="Microsoft.NET.Sdk">
  <!-- 0.7.0 (start): standalone process that turns structured instructions (BIM Task IR) into a plan, runs it against a backend
       (for now ONLY the simulated one), verifies, and recovers after an interruption. It has no access to the Revit API or to grants. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Bimbridge.AgentHost</AssemblyName>
    <RootNamespace>Bimbridge.AgentHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bimbridge.Protocol\Bimbridge.Protocol.csproj" />
    <ProjectReference Include="..\Bimbridge.Engine\Bimbridge.Engine.csproj" />
    <!-- alpha3: typed bridge transport (RevitConnection: handshake, pipe server pid, heartbeat, uncertain timeouts) -->
    <ProjectReference Include="..\Bimbridge.Bridge\Bimbridge.Bridge.csproj" />
    <ProjectReference Include="..\Bimbridge.Setup.Core\Bimbridge.Setup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 0.9.0: Rust Geometry Engine (FFI) next to the executable if it is built; without it, C# (controlled degradation) -->
    <None Include="..\..\native\power_engine\target\release\libbimbridge_power_engine.so" Condition="Exists('..\..\native\power_engine\target\release\libbimbridge_power_engine.so')" CopyToOutputDirectory="PreserveNewest" Link="libbimbridge_power_engine.so" />
    <None Include="..\..\native\power_engine\target\x86_64-pc-windows-gnu\release\bimbridge_power_engine.dll" Condition="Exists('..\..\native\power_engine\target\x86_64-pc-windows-gnu\release\bimbridge_power_engine.dll')" CopyToOutputDirectory="PreserveNewest" Link="bimbridge_power_engine.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
</Project>
