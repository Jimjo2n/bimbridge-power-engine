<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Revit add-in. It is built once per version:
      dotnet build -c Release -p:RevitVersion=2024   (net48)
      dotnet build -c Release -p:RevitVersion=2025   (net8.0-windows)
      dotnet build -c Release -p:RevitVersion=2027   (net10.0-windows)
    On the development PC you can build against the real installation:
      -p:RevitApiDir="C:\Program Files\Autodesk\Revit 2024"
    Without it, the Nice3point.Revit.Api reference packages are used (build only; they are neither copied nor distributed).
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <TargetFramework Condition="$(RevitVersion) &lt; 2025">net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2025">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2027">net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Bimbridge.Addin</AssemblyName>
    <RootNamespace>Bimbridge.Addin</RootNamespace>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2023">$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2024">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2025">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2026">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
    <OutputPath>bin\$(Configuration)\R$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <!-- reference package version per Revit version -->
    <RevitRefVersion Condition="'$(RevitVersion)' == '2022'">2022.1.80</RevitRefVersion>
    <RevitRefVersion Condition="'$(RevitVersion)' == '2023'">2023.1.90</RevitRefVersion>
    <RevitRefVersion Condition="'$(RevitVersion)' == '2024'">2024.3.60</RevitRefVersion>
    <RevitRefVersion Condition="'$(RevitVersion)' == '2025'">2025.4.60</RevitRefVersion>
    <RevitRefVersion Condition="'$(RevitVersion)' == '2026'">2026.4.10</RevitRefVersion>
    <RevitRefVersion Condition="'$(RevitVersion)' == '2027'">2027.0.0</RevitRefVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitApiDir)' == ''">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitRefVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitRefVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitApiDir)' != ''">
    <Reference Include="RevitAPI"><HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Core" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <!-- WPF for the windows. No UseWPF (there is no XAML): this way it also builds on Linux without the desktop SDK. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <!-- recipes\*.cs are compiled inside Revit with Roslyn (tarea iniciar receta=…); they are not part of the assembly -->
    <Compile Remove="recipes\**" />
    <None Include="recipes\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bimbridge.Protocol\Bimbridge.Protocol.csproj" />
    <ProjectReference Include="..\Bimbridge.Engine\Bimbridge.Engine.csproj" />
    <!-- Find new installers and read install.json (Update button) -->
    <ProjectReference Include="..\Bimbridge.Setup.Core\Bimbridge.Setup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Bimbridge.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
