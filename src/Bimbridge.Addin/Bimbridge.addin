<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to %APPDATA%\Autodesk\Revit\Addins\<version>\ together with the Bimbridge\ folder
  (or ask IT to deploy it). Assembly is relative to this file.
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>BIMBRIDGE</Name>
    <Assembly>Bimbridge\Bimbridge.Addin.dll</Assembly>
    <AddInId>6F1C2B7E-4D0A-4E8B-9C3D-1A2B3C4D5E6F</AddInId>
    <FullClassName>Bimbridge.Addin.App</FullClassName>
    <VendorId>BIMBRIDGE</VendorId>
    <VendorDescription>BIMBRIDGE (VDC)</VendorDescription>
  </AddIn>
</RevitAddIns>
