<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Double-click installer: Bimbridge.Setup.exe
    net48 because it ships with Windows 10/11: nothing needs to be installed first.
    Embeds payload.zip (add-in 2022-2027 + self-contained bridge), built by build.sh/build.ps1.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Bimbridge.Setup</AssemblyName>
    <RootNamespace>Bimbridge.Setup</RootNamespace>
    <ApplicationIcon>setup.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>BIMBRIDGE installer</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Core" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bimbridge.Protocol\Bimbridge.Protocol.csproj" />
    <ProjectReference Include="..\Bimbridge.Setup.Core\Bimbridge.Setup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same style and icons as the ribbon -->
    <Compile Include="..\Bimbridge.Addin\Ui\Theme.cs" Link="Shared\Theme.cs" />
    <Compile Include="..\Bimbridge.Addin\Ui\Icons.cs" Link="Shared\Icons.cs" />
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>
  <!-- The Protocol and Setup.Core DLLs are embedded in the .exe so it is a single file. -->
  <Target Name="EmbedDeps" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" LogicalName="lib.%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)" />
    </ItemGroup>
  </Target>
</Project>
