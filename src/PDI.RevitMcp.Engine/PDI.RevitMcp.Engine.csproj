         en net8 se compilan caminos más rápidos (AVX2 en las mallas). -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PDI.RevitMcp.Protocol\PDI.RevitMcp.Protocol.csproj" />
  </ItemGroup>
</Project>
