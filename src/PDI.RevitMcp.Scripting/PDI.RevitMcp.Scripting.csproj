<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compilador del runner general (exec). Sólo depende de Roslyn y de la BCL: no conoce Revit.
    Se distribuye en la carpeta roslyn\ junto con sus dependencias y se carga sólo la primera vez que se usa exec:
      Revit 2022–2024 (.NET Framework 4.8): AssemblyResolve sobre esa carpeta.
      Revit 2025–2026 (.NET 8): contexto de carga propio (AssemblyLoadContext), para no chocar con otro Roslyn ya cargado en Revit.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
</Project>
