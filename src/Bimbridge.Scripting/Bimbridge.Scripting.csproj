<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiler for the general runner (exec). Depends only on Roslyn and the BCL: knows nothing about Revit.
    Shipped in the roslyn\ folder with its dependencies and loaded only the first time exec is used:
      Revit 2022–2024 (.NET Framework 4.8): AssemblyResolve over that folder.
      Revit 2025–2026 (.NET 8): its own load context (AssemblyLoadContext), so it does not clash with another Roslyn already loaded in Revit.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
