    <AssemblyName>PDI.RevitMcp.Bridge</AssemblyName>
    <RootNamespace>PDI.RevitMcp.Bridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PDI.RevitMcp.Protocol\PDI.RevitMcp.Protocol.csproj" />
    <!-- Sólo para las guías (texto) y el catálogo de operaciones: el motor geométrico vive en Revit. -->
    <ProjectReference Include="..\PDI.RevitMcp.Engine\PDI.RevitMcp.Engine.csproj" />
  </ItemGroup>
</Project>
