<Project Sdk="Microsoft.NET.Sdk">
  <!-- MCP bridge: launched by Claude Code or Codex over stdio, talks to Revit over a named pipe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Bimbridge.Bridge</AssemblyName>
    <RootNamespace>Bimbridge.Bridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bimbridge.Protocol\Bimbridge.Protocol.csproj" />
    <!-- Only for the guides (text) and the operation catalog: the geometry engine lives in Revit. -->
    <ProjectReference Include="..\Bimbridge.Engine\Bimbridge.Engine.csproj" />
  </ItemGroup>
</Project>
