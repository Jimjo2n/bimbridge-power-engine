{
 "schema": "bimbridge.campaign080/1",
 "item": "N8-02",
 "title": "View and template configuration",
 "initial_status": "Disposable LOCAL copy, not workshared, of a public model (e.g. an Autodesk sample). Revit 2024 with BIMBRIDGE 0.8.0 installed; config.json levels RPW.",
 "variables": {
  "level": "name of a level in the model"
 },
 "steps": [
  {
   "name": "create and configure an RCP",
   "op": "plan",
   "args": {
    "ops": [
     {
      "op": "view_create",
      "type": "rcp",
      "level": "${level}",
      "name": "BB-N8-02 RCP"
     },
     {
      "op": "view_set",
      "ids": "@1",
      "detail": "medium"
     },
     {
      "op": "view_hide",
      "view": "@1",
      "cats": "LightingDevices"
     }
    ],
    "summary": "campaign 0.8.0"
   },
   "save": {
    "plan": "plan_id"
   }
  },
  {
   "name": "apply",
   "op": "commit",
   "args": {
    "plan_id": "${plan}"
   },
   "write": true
  },
  {
   "name": "the view exists",
   "op": "catalog",
   "args": {
    "kind": "views",
    "search": "BB-N8-02"
   },
   "contains": [
    "BB-N8-02 RCP"
   ]
  }
 ]
}